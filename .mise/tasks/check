set -euo pipefail

task_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repository_root="$(git -C "$task_directory" rev-parse --show-toplevel)"
cd "$repository_root"

unformatted="$(
  git ls-files -z --cached --others --exclude-standard -- '*.go' |
    while IFS= read -r -d '' file; do
      if [[ -f "$file" ]]; then
        gofmt -l "$file"
      fi
    done
)"
if [[ -n "$unformatted" ]]; then
  echo "The following Go files need formatting:" >&2
  echo "$unformatted" >&2
  exit 1
fi

golangci-lint run
go test ./...
